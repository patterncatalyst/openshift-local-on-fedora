# shipping-policy-operator Containerfile: a ubi10/ubi-micro runtime carrying
# one static binary and nothing else. No shell, no package manager, no CGO.
# The manager binary is compiled on the host first (CGO_ENABLED=0, a fully
# static binary ubi-micro's no-libc runtime can execute), then copied in; the
# image build itself pulls only from registry.access.redhat.com and never
# touches Docker Hub.
#
# Build the binary and image, then push to the integrated registry (see
# README.md for the full walkthrough and the build-and-push one-liner):
#   CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o manager ./cmd
#   podman build -t shipping-policy-operator:v1 -f Containerfile .
#   podman push ... default-route-openshift-image-registry.apps-crc.testing/patterns/shipping-policy-operator:v1

FROM registry.access.redhat.com/ubi10/ubi-micro:10.2

COPY --chown=1001:0 manager /manager

USER 1001:0

ENTRYPOINT ["/manager"]
